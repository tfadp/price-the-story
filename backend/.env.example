# ============================================================
# Price the Story — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# REQUIRED — Powers the PM synthesis verdict (Node 11) and
# growth bet extraction (Node 6). Get yours at console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OPTIONAL — Improves analyst estimates (Node 4).
# Free tier at financialmodelingprep.com (no credit card needed)
FMP_API_KEY=

# OPTIONAL — Improves news + earnings transcripts (Nodes 5, 6).
# Free tier at finnhub.io (60 req/min, no credit card needed)
FINNHUB_API_KEY=

# OPTIONAL — Redis cache. If not set, caching is skipped (Phase 1).
# Install Redis locally: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379

# App config
APP_VERSION=0.1.0
LOG_LEVEL=INFO
